{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client", "google.maps"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["artifacts/bacchus-marsh-taxi/src/*"],
      "@workspace/api-client-react": ["lib/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["lib/api-zod/src/index.ts"],
      "@workspace/db": ["lib/db/src/index.ts"],
      "@assets/*": ["attached_assets/*"]
    }
  },
  "include": [
    "server.ts",
    "artifacts/bacchus-marsh-taxi/src/**/*",
    "artifacts/api-server/src/**/*",
    "lib/api-client-react/src/**/*",
    "lib/api-zod/src/**/*",
    "lib/db/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib/api-spec/**/*",
    "lib/db/drizzle.config.ts"
  ]
}
